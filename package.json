{
  "name": "lulu",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "core",
    "client/web",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @lulu/core -w @lulu/web",
    "check": "ast-grep test --test-dir scripts/ast-rule-tests --skip-snapshot-tests && ast-grep scan && npm run build -w @lulu/core && npm run check -w @lulu/cf -w @lulu/web && tsc -p tsconfig.e2e.json",
    "test": "npm run test --workspaces --if-present",
    "lint": "node scripts/no-comments.mjs && oxlint --type-aware core/src apps/cf/src client/web/src",
    "test:e2e": "npm run build && e2e run"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.3",
    "@e2e-dev/web": "0.17.0",
    "@types/node": "^22.15.0",
    "e2e": "0.25.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "overrides": {
    "undici@^7.0.0": "^7.30.1",
    "undici@^8.0.0": "^8.12.3",
    "@earendil-works/pi-coding-agent": {
      "minimatch": "^11.0.8"
    },
    "workbox-build": {
      "glob": "^14.0.5"
    }
  }
}
