{
  "name": "lulu",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "core",
    "client",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present && npm run build --prefix client/desktop",
    "check": "grep -rnE '(from|import)[^[:alnum:]_]*(node|cloudflare):' core/src; test $? -eq 1 && npm run build -w @lulu/core && npm run check -w @lulu/cf -w @lulu/client",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint:comments && oxlint --type-aware core/src apps/cf/src client/web/src",
    "lint:comments": "node scripts/lint-comments.mjs"
  },
  "devDependencies": {
    "@ast-grep/lang-bash": "^0.0.8",
    "@ast-grep/lang-cpp": "^0.0.6",
    "@ast-grep/lang-go": "^0.0.6",
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/lang-swift": "^0.0.8",
    "@ast-grep/napi": "^0.51.3",
    "@types/node": "^22.15.0",
    "htmlparser2": "^12.0.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006"
  },
  "license": "MIT",
  "overrides": {
    "undici@^7.0.0": "^7.30.1",
    "undici@^8.0.0": "^8.12.3",
    "@earendil-works/pi-coding-agent": {
      "minimatch": "^11.0.8"
    },
    "workbox-build": {
      "glob": "^14.0.5"
    }
  }
}
