{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "e2e.bugbash.config.ts",
    "e2e.ios.config.ts",
    "e2e.ios.bugbash.config.ts",
    "e2e.config.ts",
    "tests/**/*.e2e.ts"
  ]
}
