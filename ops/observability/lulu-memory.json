{
  "uid": "lulu-memory",
  "title": "Lulu memory diagnostics",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 105,
      "title": "Requests carrying memory",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Model request attempts carrying rendered memory content or a non-empty memory catalog. Template-only seeds are excluded. Includes tool rounds, retries and recovery; not unique user messages or proof the provider accepted or used the memory.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not observed"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time(lulu_memory_request_attempts_total{lulu_memory_coverage=~\"content|catalog\"}[$__range])) or (sum(sum_over_time(lulu_memory_request_attempts_total[$__range])) * 0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 100,
      "title": "Requests with memory content",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Counts model request attempts at the pi beforeRequest hook, including tool rounds, retries and recovery. Empty templates and frontmatter-only seeds do not count as content. No data means unobserved, not zero. History before rollout cannot be backfilled.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not observed"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time(lulu_memory_request_attempts_total{lulu_memory_coverage=\"content\"}[$__range])) or (sum(sum_over_time(lulu_memory_request_attempts_total[$__range])) * 0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 101,
      "title": "Requests with catalog only",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Counts model request attempts at the pi beforeRequest hook, including tool rounds, retries and recovery. Empty templates and frontmatter-only seeds do not count as content. No data means unobserved, not zero. History before rollout cannot be backfilled.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not observed"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time(lulu_memory_request_attempts_total{lulu_memory_coverage=\"catalog\"}[$__range])) or (sum(sum_over_time(lulu_memory_request_attempts_total[$__range])) * 0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 102,
      "title": "Requests with empty template",
