[Unit]
Description=Collect Lulu third-party account usage
After=network-online.target

[Service]
Type=oneshot
RuntimeDirectory=lulu-service-accounts
RuntimeDirectoryMode=0700
Environment=TMPDIR=%t/lulu-service-accounts
WorkingDirectory=%h/projects/lulu
LoadCredentialEncrypted=op-token:%h/.config/lulu-observability/op-token.cred
ExecStart=/usr/bin/mise exec -- /bin/bash ops/observability/collect.sh service-accounts
TimeoutStartSec=150
NoNewPrivileges=true
