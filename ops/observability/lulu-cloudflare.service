[Unit]
Description=Collect Lulu Cloudflare usage
After=network-online.target

[Service]
Type=oneshot
RuntimeDirectory=lulu-cloudflare
RuntimeDirectoryMode=0700
Environment=TMPDIR=%t/lulu-cloudflare
WorkingDirectory=%h/projects/lulu
LoadCredentialEncrypted=op-token:%h/.config/lulu-observability/op-token.cred
ExecStart=/usr/bin/mise exec -- /bin/bash ops/observability/collect.sh cloudflare
TimeoutStartSec=150
NoNewPrivileges=true
