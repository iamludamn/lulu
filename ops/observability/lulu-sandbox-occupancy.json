{
  "title": "Lulu sandbox occupancy",
  "uid": "lulu-sandbox-occupancy",
  "description": "Window-clipped application observations from the Durable accounting ledger. A separate datasource exposes the window results alongside the existing OpenTelemetry operation latency dashboards.",
  "tags": [
    "lulu"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Window snapshot",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Subagent active time",
      "description": "Durable generation segments, including model requests and tool waits. Queues, retry backoff, deferred polling sleeps, settled or stopped work are excluded.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lulu-sandbox-accounting"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lulu-sandbox-accounting"
          },
          "expr": "lulu_sandbox_window{measure=\"delegate_active_seconds\",from=\"${__from}\",to=\"${__to}\"}",
          "instant": true,
          "range": false,
          "legendFormat": "{{measure}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sandbox ready time",
      "description": "Application-observed readiness from a successful open, through confirmed renewal, up to pause, destroy or the observed lease boundary. Excludes paused retention, startup and unknown time. Provider billing requires separate reconciliation.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lulu-sandbox-accounting"
