{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lulu",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOTS",
        "class_name": "Bot",
      },
      {
        "name": "MEMORY",
        "class_name": "Memory",
      },
      {
        "name": "ARTIFACTS",
        "class_name": "Artifact",
      },
    ],
  },
  "kv_namespaces": [
    {
      "binding": "LULU_MCP",
      "id": "92e198ee66014ccdb1e69776615c880c",
    },
  ],
  "d1_databases": [
    {
      "binding": "ARTIFACT_METADATA",
      "database_name": "lulu-artifacts",
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Bot", "Registry", "Memory", "Artifact"],
    },
    {
      "tag": "v2",
      "deleted_classes": ["Registry"],
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "../../client/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*"],
  },
  "vars": {
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://otel.ludamn.xyz",
    "OTEL_SERVICE_NAME": "lulu",
  },
  "observability": {
    "enabled": true,
    "issues": { "enabled": true },
  },
}
