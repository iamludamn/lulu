{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lulu",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOTS",
        "class_name": "Bot",
      },
      {
        "name": "MEMORY",
        "class_name": "Memory",
      },
      {
        "name": "ARTIFACTS",
        "class_name": "Artifact",
      },
    ],
  },
  "kv_namespaces": [
    {
      "binding": "LULU_MCP",
      "id": "92e198ee66014ccdb1e69776615c880c",
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Bot", "Registry", "Memory", "Artifact"],
    },
    {
      "tag": "v2",
      "deleted_classes": ["Registry"],
    },
  ],
  "assets": {
    "directory": "../../client/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://otel.ludamn.xyz",
    "OTEL_SERVICE_NAME": "lulu",
  },
  "observability": {
    "enabled": true,
  },
}
